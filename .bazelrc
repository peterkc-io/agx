# Cargo remains available; Bazel is an additional build and test path.
common --enable_bzlmod
build --sandbox_default_allow_network=false
build --test_env=DO_NOT_TRACK=1
build --test_env=TZ=UTC
test --test_output=errors
test --run_under=//:bazel_test_env
# Keep HOME-based Unix sockets below platform path limits. Linux isolates /tmp.
test --test_tmpdir=/tmp/agx-tests
